# Your Supabase API URL (the deployed app uses a same-origin CloudFront proxy).
VITE_SUPABASE_URL=https://your-project.supabase.co
# Browser-safe anon/publishable key. Never use a service-role key here.
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Deploy targets, read only by scripts/deploy-aws.mjs.
AWS_ACCOUNT_ID=
AWS_REGION=us-east-2
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
AWS_CLOUDFRONT_DOMAIN=
AWS_EC2_INSTANCE_ID=
